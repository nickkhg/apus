#!/usr/bin/expect -f
# `make demo`: boots the installed disk in a window, logs in on the serial
# console, and starts apus-compositor. Click an icon in the dock to open
# an app. The VM keeps running until you close its window.
#
# With APUS_UI_DIR set (for example /mnt/host/ui), the VM runs the
# programs from that directory, not the installed ones.

set timeout 120
log_user 1
source [file dirname [info script]]/../tests/lib.exp

set bin ""
set uienv ""
if {[info exists env(APUS_UI_DIR)]} {
    set bin "$env(APUS_UI_DIR)/"
    # The compositor starts the apps of /Applications, so it needs the
    # directory in its own environment. Without this the compositor is the
    # new build and every app it starts is the one in the image.
    set uienv "APUS_UI_DIR=$env(APUS_UI_DIR) "
}
# How many pixels there are to a point. A screen with small pixels wants 2.
if {[info exists env(APUS_SCALE)]} {
    append uienv "APUS_SCALE=$env(APUS_SCALE) "
}
# Which renderer draws. The demo asks for the GPU, because this is the one
# place that shows what the machine can do. The tests keep the CPU, whose
# pixels are the same on every run. `gpu` falls back to the CPU on a machine
# with no GPU behind it, so this is safe everywhere. See docs/ui.md and
# docs/gpu.md.
set renderer "gpu"
if {[info exists env(APUS_RENDERER)]} {
    set renderer $env(APUS_RENDERER)
}
append uienv "APUS_RENDERER=$renderer "

# The compositor times its own frames and writes a line for every 60 of
# them, which is about one line a second. The Debug menu of the window
# reads those lines. APUS_FRAME_LOG names another number, or 0 for none.
set frameLog 60
if {[info exists env(APUS_FRAME_LOG)]} {
    set frameLog $env(APUS_FRAME_LOG)
}
if {$frameLog ne "0"} {
    append uienv "APUS_FRAME_LOG=$frameLog "
}

# VM_CUSTOM_GPU adds the virtio-gpu device that this program makes, which
# is the one that carries the GPU of the Mac. apus-gpu then puts the
# compositor on it. Without the renderer on the host, or without the Zink
# package in the guest, both fall back and the compositor draws with the
# CPU. See docs/gpu.md.
#
# The compositor draws on that device and not on the one of the framework.
# The framework's device is a 2D scanout with no 3D, so a frame drawn on
# the GPU had to cross to it through the memory of the guest. The window
# shows the pictures of our device, and nothing crosses.
spawn env VM_GPU=window VM_CUSTOM_GPU=1 $env(APUS_VM) installed
login
send "LIBSEAT_BACKEND=noop APUS_DRM_DEVICE=/dev/dri/card1 ${uienv}apus-gpu ${bin}apus-compositor &\r"
expect {
    "COMPOSITOR-READY"     {}
    "apus-compositor:" { fail "compositor reported an error" }
}
send_user "\n\n>>> Apus is running in the window.\n"
send_user ">>> Press Super to open Summon, and type the name of an app.\n"
send_user ">>> Ctrl+Alt+Backspace stops the compositor.\n"
send_user ">>> Close the window to stop the VM.\n\n"
set timeout -1
expect eof
