#!/usr/bin/expect -f
# `make demo`: boots the installed disk in a window, logs in on the serial
# console, and starts mydistro-compositor. Click an icon in the dock to open
# an app. The VM keeps running until you close its window.
#
# With MYDISTRO_UI_DIR set (for example /mnt/host/ui), the VM runs the
# programs from that directory, not the installed ones.

set timeout 120
log_user 1
source [file dirname [info script]]/../tests/lib.exp

set bin ""
set uienv ""
if {[info exists env(MYDISTRO_UI_DIR)]} {
    set bin "$env(MYDISTRO_UI_DIR)/"
    # The compositor starts the apps of /Applications, so it needs the
    # directory in its own environment. Without this the compositor is the
    # new build and every app it starts is the one in the image.
    set uienv "MYDISTRO_UI_DIR=$env(MYDISTRO_UI_DIR) "
}
# How many pixels there are to a point. A screen with small pixels wants 2.
if {[info exists env(MYDISTRO_SCALE)]} {
    append uienv "MYDISTRO_SCALE=$env(MYDISTRO_SCALE) "
}
# Which renderer draws. The demo asks for the GPU, because this is the one
# place that shows what the machine can do. The tests keep the CPU, whose
# pixels are the same on every run. `gpu` falls back to the CPU on a machine
# with no GPU behind it, so this is safe everywhere. See docs/ui.md and
# docs/gpu.md.
set renderer "gpu"
if {[info exists env(MYDISTRO_RENDERER)]} {
    set renderer $env(MYDISTRO_RENDERER)
}
append uienv "MYDISTRO_RENDERER=$renderer "

# VM_CUSTOM_GPU adds the virtio-gpu device that this program makes, which
# is the one that carries the GPU of the Mac. mydistro-gpu then puts the
# compositor on it. Without the renderer on the host, or without the Zink
# package in the guest, both fall back and the compositor draws with the
# CPU. See docs/gpu.md.
spawn env VM_GPU=window VM_CUSTOM_GPU=1 $env(MYDISTRO_VM) installed
login
send "LIBSEAT_BACKEND=noop ${uienv}mydistro-gpu ${bin}mydistro-compositor &\r"
expect {
    "COMPOSITOR-READY"     {}
    "mydistro-compositor:" { fail "compositor reported an error" }
}
send_user "\n\n>>> mydistro is running in the window.\n"
send_user ">>> Press Super to open Summon, and type the name of an app.\n"
send_user ">>> Ctrl+Alt+Backspace stops the compositor.\n"
send_user ">>> Close the window to stop the VM.\n\n"
set timeout -1
expect eof
