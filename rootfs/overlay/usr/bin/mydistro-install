#!/bin/bash
# mydistro-install - install the running live system onto a disk.
#
#   mydistro-install [-y] [DISK]
#
# The live system runs on a tmpfs overlay (systemd.volatile=overlay), so its
# root partition is never modified. We mount that pristine partition again
# read-only and let systemd-repart build the target from it.
#
# Resulting layout (GPT, see /usr/lib/mydistro/repart.d):
#   1  EFI system partition (FAT32, 512M)  systemd-boot + kernel, at /boot
#   2  root (ext4)                         rest of the disk
set -euo pipefail

# Fixed partition UUIDs of the live image (image/repart.d in the source tree).
LIVE_ESP=/dev/disk/by-partuuid/6d79646f-0000-4000-8000-000000000001
LIVE_ROOT=/dev/disk/by-partuuid/6d79646f-0000-4000-8000-000000000002
WORK=/run/mydistro-install

die() { echo "mydistro-install: $*" >&2; exit 1; }
step() { echo "==> $*"; }

# /dev node of partition N of disk $1 (vda1, nvme0n1p1, mmcblk0p1, ...).
part_dev() {
    local p
    for p in /sys/block/"$1"/*/partition; do
        [[ $(<"$p") == "$2" ]] && { echo "/dev/$(basename "$(dirname "$p")")"; return; }
    done
    return 1
}

# Any failing command ends the install with a message the user (and the
# test) can see.
trap 'die "failed at line $LINENO: $BASH_COMMAND"' ERR

cleanup() {
    umount -R "$WORK/target" "$WORK/root" "$WORK/esp" 2>/dev/null || true
}

yes=0
[[ ${1:-} == -y ]] && { yes=1; shift; }
target=${1:-}

grep -qw mydistro.live /proc/cmdline || die "not running from live media"
(( EUID == 0 )) || die "must run as root"
[[ -b $LIVE_ROOT && -b $LIVE_ESP ]] || die "can't find the live partitions"

live_disk=$(basename "$(readlink -f "/sys/class/block/$(basename "$(readlink -f "$LIVE_ROOT")")/..")")

# --- Pick the target -----------------------------------------------------------
if [[ -z $target ]]; then
    echo "Disks:"
    lsblk -dpno NAME,SIZE,MODEL -e 7,11 | grep -v "^/dev/$live_disk " | sed 's/^/  /'
    read -rp "Install to: " target
fi
target=/dev/${target#/dev/}
tname=$(basename "$target")
[[ -b $target ]] || die "$target is not a block device"
[[ $tname != "$live_disk" ]] || die "refusing to install over the live media"
[[ -e /sys/block/$tname ]] || die "$target is a partition, give a whole disk"
(( $(blockdev --getsize64 "$target") >= 4 * 1024 ** 3 )) || die "$target is smaller than 4 GiB"

if (( !yes )); then
    read -rp "ALL DATA ON $target WILL BE ERASED. Type 'yes' to continue: " answer
    [[ $answer == yes ]] || die "aborted"
fi

trap cleanup EXIT
mkdir -p "$WORK"/{root,esp,target}
mount -o ro "$LIVE_ROOT" "$WORK/root"
# The ESP is already mounted read-write (systemd auto-mounts the ESP it booted
# from), and vfat can't be mounted a second time with different ro/rw flags.
mount "$LIVE_ESP" "$WORK/esp"

# --- Partition and copy ------------------------------------------------------------
step "Partitioning $target and copying the system (this takes a minute)"
systemd-repart --dry-run=no --empty=force --seed=random \
    --definitions=/usr/lib/mydistro/repart.d "$target" >/dev/null \
    || die "systemd-repart failed"
udevadm settle
esp=$(part_dev "$tname" 1) && root=$(part_dev "$tname" 2) || die "new partitions not found"
esp_uuid=$(lsblk -no PARTUUID "$esp")
root_uuid=$(lsblk -no PARTUUID "$root")

# --- Configure the installed system -----------------------------------------------
step "Configuring the installed system"
mount "$root" "$WORK/target"
mount "$esp" "$WORK/target/boot"

cat >> "$WORK/target/etc/fstab" <<EOF
PARTUUID=$root_uuid	/	ext4	rw,relatime	0 1
PARTUUID=$esp_uuid	/boot	vfat	rw,umask=0077	0 2
EOF

step "Installing the boot loader entry"
rm -f "$WORK/target/boot/loader/entries/"*.conf
cat > "$WORK/target/boot/loader/entries/mydistro.conf" <<EOF
title   mydistro
linux   /Image
initrd  /initramfs-linux.img
options root=PARTUUID=$root_uuid rw console=ttyAMA0
EOF
cat > "$WORK/target/boot/loader/loader.conf" <<EOF
default mydistro.conf
timeout 1
EOF

date -u +%Y-%m-%dT%H:%M:%SZ > "$WORK/target/etc/mydistro-installed"

cleanup
sync
step "Installation complete. Power off, remove the live media and boot from $target."
