# Build environment for mydistro: an Arch Linux ARM system with the tools to
# assemble another one (pacstrap, systemd-repart, mkfs.*).
#
# The base is the official Arch Linux ARM rootfs tarball. `make builder`
# downloads it to build/cache/ and checks its SHA-256 first.
FROM scratch
ADD cache/ArchLinuxARM-aarch64-latest.tar.gz /

# Builder-only pacman tweaks (the image we build keeps the defaults):
#  - CheckSpace fails without a real mount table for /
#  - the download sandbox (DownloadUser) can't switch users in the build VM
RUN sed -i -e 's/^CheckSpace/#CheckSpace/' -e 's/^DownloadUser/#DownloadUser/' \
        -e 's/^\[options\]/[options]\nDisableSandbox/' /etc/pacman.conf \
    && pacman-key --init \
    && pacman-key --populate archlinuxarm \
    && pacman -Syu --noconfirm --needed \
        arch-install-scripts base-devel dosfstools e2fsprogs mtools \
    && pacman -Scc --noconfirm

# makepkg refuses to run as root; mydistro packages build as this user.
RUN useradd --create-home builder

CMD ["bash"]
