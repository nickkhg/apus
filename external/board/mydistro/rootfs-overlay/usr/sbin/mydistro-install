#!/bin/sh
# mydistro-install - install the running live system onto a disk.
#
#   mydistro-install [-y] [DISK]
#
# The live root filesystem is mounted read-only, so we can copy it
# block-for-block to the target and grow it, rather than unpacking files.
#
# Resulting layout (GPT):
#   1  EFI system partition (FAT32)  grub + kernel
#   2  root (ext4)                   copy of the live rootfs, grown to fill
set -eu

ESP_SIZE=128MiB
ROOT_TYPE=b921b045-1df0-41c3-af44-4c6f280d3fae   # Linux root (ARM-64)

die() { echo "mydistro-install: $*" >&2; exit 1; }
step() { echo "==> $*"; }

# /dev node of partition N of disk $1 (vda1, nvme0n1p1, mmcblk0p1, ...),
# looked up through sysfs so we don't guess naming schemes.
part_dev() {
    for p in /sys/block/"$1"/*/partition; do
        [ "$(cat "$p")" = "$2" ] && { echo "/dev/$(basename "$(dirname "$p")")"; return; }
    done
    return 1
}

wait_for() {
    i=0
    while [ ! -b "$1" ]; do
        i=$((i + 1)); [ $i -le 10 ] || die "timed out waiting for $1"
        sleep 1
    done
}

yes=0
[ "${1:-}" = "-y" ] && { yes=1; shift; }
target="${1:-}"

grep -qw mydistro.live /proc/cmdline || die "not running from live media"
[ "$(id -u)" = 0 ] || die "must run as root"

# --- Where are we booted from? -----------------------------------------------
src_sys=$(readlink -f "/sys/dev/block/$(mountpoint -d /)")
src_root=/dev/$(basename "$src_sys")
src_disk=$(basename "$(dirname "$src_sys")")
src_esp=$(part_dev "$src_disk" 1) || die "can't find live EFI partition"

# --- Pick the target -----------------------------------------------------------
candidates=""
for d in /sys/block/*; do
    n=$(basename "$d")
    case "$n" in loop*|ram*|zram*|sr*) continue ;; esac
    [ "$n" = "$src_disk" ] && continue
    [ "$(cat "$d/size")" -gt 0 ] || continue
    candidates="$candidates $n"
done

if [ -z "$target" ]; then
    [ -n "$candidates" ] || die "no disks found to install to"
    echo "Available disks:"
    for n in $candidates; do
        echo "  /dev/$n  $(( $(cat /sys/block/$n/size) / 2048 )) MiB"
    done
    printf "Install to: "
    read -r target
fi
target=/dev/${target#/dev/}
tname=$(basename "$target")
[ -b "$target" ] || die "$target is not a block device"
[ "$tname" != "$src_disk" ] || die "refusing to install over the live media"
[ -e "/sys/block/$tname" ] || die "$target is a partition, give a whole disk"

src_bytes=$(blockdev --getsize64 "$src_root")
tgt_bytes=$(blockdev --getsize64 "$target")
[ "$tgt_bytes" -gt $((src_bytes + 256 * 1024 * 1024)) ] || die "$target is too small"

if [ $yes = 0 ]; then
    printf "ALL DATA ON %s WILL BE ERASED. Type 'yes' to continue: " "$target"
    read -r answer
    [ "$answer" = yes ] || die "aborted"
fi

# --- Partition -------------------------------------------------------------------
step "Partitioning $target"
sfdisk --quiet --wipe always --wipe-partitions always "$target" <<EOF
label: gpt
size=$ESP_SIZE, type=U, name=esp
type=$ROOT_TYPE, name=root
EOF
tgt_esp=$(part_dev "$tname" 1) && tgt_root=$(part_dev "$tname" 2) \
    || die "kernel didn't pick up new partitions"
wait_for "$tgt_esp"; wait_for "$tgt_root"
esp_uuid=$(sfdisk --part-uuid "$target" 1 | tr 'A-Z' 'a-z')
root_uuid=$(sfdisk --part-uuid "$target" 2 | tr 'A-Z' 'a-z')

# --- Root filesystem -------------------------------------------------------------
step "Copying root filesystem"
dd if="$src_root" of="$tgt_root" bs=4M conv=fsync 2>/dev/null
e2fsck -fy "$tgt_root" >/dev/null || [ $? -le 1 ] || die "fsck of new root failed"
step "Growing root filesystem"
resize2fs "$tgt_root" >/dev/null 2>&1
tune2fs -U random "$tgt_root" >/dev/null

# --- Bootloader --------------------------------------------------------------------
step "Installing bootloader"
mkfs.vfat -F 32 -n MYDISTRO "$tgt_esp" >/dev/null
mnt=$(mktemp -d)
mkdir "$mnt/src" "$mnt/esp" "$mnt/root"
trap 'umount "$mnt/src" "$mnt/esp" "$mnt/root" 2>/dev/null; rm -rf "$mnt"' EXIT
mount -o ro "$src_esp" "$mnt/src"
mount "$tgt_esp" "$mnt/esp"
cp -r "$mnt/src/EFI" "$mnt/src/Image" "$mnt/esp/"
cat > "$mnt/esp/EFI/BOOT/grub.cfg" <<EOF
set default="0"
set timeout="3"

menuentry "mydistro" {
	linux /Image root=PARTUUID=$root_uuid rootwait rw console=ttyAMA0
}
EOF

# --- Configure the installed system -----------------------------------------------
step "Configuring installed system"
mount "$tgt_root" "$mnt/root"
echo "PARTUUID=$esp_uuid	/boot/efi	vfat	defaults	0	0" >> "$mnt/root/etc/fstab"
date -u +%Y-%m-%dT%H:%M:%SZ > "$mnt/root/etc/mydistro-installed"

umount "$mnt/src" "$mnt/esp" "$mnt/root"
sync
step "Installation complete. Power off, remove the live media and boot from $target."
