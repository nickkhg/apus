# Zink, Mesa's OpenGL on Vulkan, built to start without nullDescriptor.
#
# With this the compositor's GLES renderer reaches the GPU of the Mac: GLES
# to Zink, Zink to Vulkan, Vulkan to Venus, Venus to MoltenVK and Metal.
# Without it, Mesa in the guest draws with llvmpipe on the CPU.
#
# The package carries one file, in a directory of its own. Arch's mesa owns
# /usr/lib, this driver has a check removed, and only a program that asks
# for it by name should get it:
#
#   apus-gpu apus-compositor
#
# See docs/gpu.md.
pkgname=apus-zink
pkgver=26.2.3
pkgrel=1
pkgdesc="Mesa's Zink driver, for OpenGL on the Vulkan of the Mac"
arch=('aarch64')
url='https://www.mesa3d.org/'
license=('MIT')
depends=('mesa' 'libdrm' 'expat' 'zlib' 'zstd' 'vulkan-icd-loader')
source=("https://archive.mesa3d.org/mesa-$pkgver.tar.xz" 'no-null-descriptor.py'
        'apus-gpu')
sha256sums=('SKIP' 'SKIP' 'SKIP')

prepare() {
    python3 no-null-descriptor.py \
        "mesa-$pkgver/src/gallium/drivers/zink/zink_screen.c"

    # The driver carries the full version of Mesa in its file name, and Arch
    # adds a part of its own to that version. A program reaches this driver
    # by putting its directory first on the library path, which works only
    # if the two names are the same. The builder has the same mesa that the
    # image installs, so the name comes from there.
    local installed
    installed=$(basename /usr/lib/libgallium-*.so .so)
    echo "${installed#libgallium-}" > "mesa-$pkgver/VERSION"
}

build() {
    # Zink alone. None of the drivers that need LLVM or Rust are built, so
    # this takes about a minute.
    #
    # The platforms have to be the ones Arch builds. Arch's libEGL asks this
    # library for the DRI3 loader of X11, by name and by version, and a
    # library without that platform in it cannot answer. EGL then finds no
    # driver at all, whatever the program asked for.
    meson setup "mesa-$pkgver" build \
        --prefix /usr --libdir lib --buildtype plain --wrap-mode nodownload \
        -D gallium-drivers=zink \
        -D vulkan-drivers= \
        -D platforms=x11,wayland \
        -D glx=disabled \
        -D egl=enabled \
        -D gbm=enabled \
        -D opengl=true \
        -D gles1=disabled \
        -D gles2=enabled \
        -D llvm=disabled \
        -D video-codecs= \
        -D vulkan-layers= \
        -D install-mesa-clc=false \
        -D build-tests=false
    meson compile -C build
}

package() {
    # The driver alone, and nothing else that the build makes. EGL and GBM
    # come from mesa, which is the same version, so the two sides agree. Our
    # own EGL and GBM beside this file would come first on the library path
    # as well, and they look for their parts where they are not.
    local driver
    driver=$(basename build/src/gallium/targets/dri/libgallium-*.so)
    install -Dm755 "build/src/gallium/targets/dri/$driver" \
        "$pkgdir/usr/lib/apus-zink/$driver"
    install -Dm755 apus-gpu "$pkgdir/usr/bin/apus-gpu"
}
