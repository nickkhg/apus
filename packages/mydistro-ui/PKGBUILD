# The Swift UI (ui/ in the source tree). build.sh copies ui/ next to this
# file before makepkg runs.
#
# The libraries are dynamic: the toolkit, the shell and the rest go to
# /usr/lib, and every program on the machine draws with that one copy. The
# Swift runtime goes to /usr/lib/swift/linux, so the programs no longer
# carry a copy of it each. See docs/ui.md.
pkgname=mydistro-ui
pkgver=0.1.0
pkgrel=1
pkgdesc='mydistro user interface (Swift)'
arch=('aarch64')
license=('custom')
depends=(
    gcc-libs glibc
    libdrm mesa            # display, GPU rendering
    libinput systemd-libs libxkbcommon seatd   # input, keymaps, seat
    wayland                # app protocol
    freetype2 harfbuzz fontconfig ttf-dejavu   # text
)
# GNU strip can't parse Swift's LLVM-built binaries; the linker strips instead.
options=('!debug' '!strip')

# The parts of the Swift runtime that the programs of this system need.
# Nothing here uses Foundation, so the Foundation libraries, ICU, the test
# libraries and the mirrors stay out: they are 60 MB that nothing opens.
_runtime=(
    libswiftCore libswiftGlibc libswiftRuntime
    libswift_Concurrency libswift_StringProcessing libswift_RegexParser
    libswift_Builtin_float libswift_Volatile libswiftSynchronization
    libswiftDispatch libdispatch libBlocksRuntime
    # UI_CONFIG=debug builds against this one.
    libswiftSwiftOnoneSupport
)

build() {
    cd "$startdir/ui"
    # SWIFT_SCRATCH (set by build.sh) keeps the build cache between image
    # builds, so only changed Swift files recompile.
    #
    # A program looks beside itself first, which is what the /mnt/host/ui
    # loop needs, and in /usr/lib after that.
    swift build -c release -Xlinker --strip-all \
        -Xlinker -rpath -Xlinker '$ORIGIN' \
        -Xlinker -rpath -Xlinker /usr/lib/swift/linux \
        --scratch-path "${SWIFT_SCRATCH:-$srcdir/.build}"
}

package() {
    cd "$startdir/ui"
    local bin
    bin=$(swift build -c release --scratch-path "${SWIFT_SCRATCH:-$srcdir/.build}" --show-bin-path)

    # App bundles go to /Applications, one directory for each app. The
    # compositor reads them and the dock shows them. A bundle that names a
    # program of its own gets that program; the program is then not a system
    # program, so the loop below does not put it in /usr/bin too.
    local bundle name exec bundled=()
    for bundle in "$startdir/ui/Apps/"*.app; do
        name=${bundle##*/}
        install -Dm644 "$bundle/app.conf" "$pkgdir/Applications/$name/app.conf"
        exec=$(sed -n 's/^[[:space:]]*exec[[:space:]]*=[[:space:]]*//p' "$bundle/app.conf")
        if [[ -n $exec && $exec != /* ]]; then
            install -Dm755 "$bin/${exec##*/}" "$pkgdir/Applications/$name/$exec"
            bundled+=("${exec##*/}")
        fi
    done

    # The libraries: one copy for the machine.
    local library
    for library in "$bin"/*.so; do
        if [[ -f $library ]]; then
            install -Dm755 "$library" "$pkgdir/usr/lib/${library##*/}"
        fi
    done

    # The Swift runtime, and the directory in the loader's search path.
    local runtime=/opt/swift/usr/lib/swift/linux name
    for name in "${_runtime[@]}"; do
        [[ -f $runtime/$name.so ]] || continue
        install -Dm755 "$runtime/$name.so" "$pkgdir/usr/lib/swift/linux/$name.so"
    done
    install -Dm644 /dev/stdin "$pkgdir/etc/ld.so.conf.d/mydistro-swift.conf" <<'CONF'
/usr/lib/swift/linux
CONF

    # The system programs: the compositor and the tools.
    local program
    for program in "$bin"/mydistro-*; do
        [[ $program == *.so ]] && continue
        if [[ -f $program && -x $program && " ${bundled[*]:-} " != *" ${program##*/} "* ]]; then
            install -Dm755 "$program" "$pkgdir/usr/bin/${program##*/}"
        fi
    done
}
