# The Swift UI (ui/ in the source tree). build.sh copies ui/ next to this
# file before makepkg runs. The Swift runtime is linked statically, so the
# target needs only the C libraries below.
pkgname=mydistro-ui
pkgver=0.1.0
pkgrel=1
pkgdesc='mydistro user interface (Swift)'
arch=('aarch64')
license=('custom')
depends=(
    gcc-libs glibc
    libdrm mesa            # display, GPU rendering
    libinput systemd-libs libxkbcommon seatd   # input, keymaps, seat
    wayland                # app protocol
    freetype2 harfbuzz fontconfig ttf-dejavu   # text
)
# GNU strip can't parse Swift's LLVM-built binaries; the linker strips instead.
options=('!debug' '!strip')

build() {
    cd "$startdir/ui"
    # SWIFT_SCRATCH (set by build.sh) keeps the build cache between image
    # builds, so only changed Swift files recompile.
    swift build -c release --static-swift-stdlib -Xlinker --strip-all \
        --scratch-path "${SWIFT_SCRATCH:-$srcdir/.build}"
}

package() {
    cd "$startdir/ui"
    local bin
    bin=$(swift build -c release --scratch-path "${SWIFT_SCRATCH:-$srcdir/.build}" --show-bin-path)

    # App bundles go to /Applications, one directory for each app. The
    # compositor reads them and the dock shows them. A bundle that names a
    # program of its own gets that program; the program is then not a system
    # program, so the loop below does not put it in /usr/bin too.
    local bundle name exec bundled=()
    for bundle in "$startdir/ui/Apps/"*.app; do
        name=${bundle##*/}
        install -Dm644 "$bundle/app.conf" "$pkgdir/Applications/$name/app.conf"
        exec=$(sed -n 's/^[[:space:]]*exec[[:space:]]*=[[:space:]]*//p' "$bundle/app.conf")
        if [[ -n $exec && $exec != /* ]]; then
            install -Dm755 "$bin/${exec##*/}" "$pkgdir/Applications/$name/$exec"
            bundled+=("${exec##*/}")
        fi
    done

    # The system programs: the compositor and the tools.
    local program
    for program in "$bin"/mydistro-*; do
        if [[ -f $program && -x $program && " ${bundled[*]:-} " != *" ${program##*/} "* ]]; then
            install -Dm755 "$program" "$pkgdir/usr/bin/${program##*/}"
        fi
    done
}
