# mydistro branding. Arch's `filesystem` package owns /usr/lib/os-release,
# so we ship ours under /usr/share/mydistro and a pacman hook copies it into
# place whenever filesystem (or this package) is installed or upgraded.
pkgname=mydistro-release
pkgver=1
pkgrel=1
pkgdesc='mydistro release information and branding'
arch=('any')
license=('custom')
depends=('filesystem')
source=('os-release' 'mydistro-branding.hook' 'mydistro-branding')
sha256sums=('SKIP' 'SKIP' 'SKIP')

package() {
    install -Dm644 os-release "$pkgdir/usr/share/mydistro/os-release"
    install -Dm644 mydistro-branding.hook "$pkgdir/usr/share/libalpm/hooks/mydistro-branding.hook"
    install -Dm755 mydistro-branding "$pkgdir/usr/share/libalpm/scripts/mydistro-branding"
}
