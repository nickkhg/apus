# The kernel that the headers are for, for example 7.2.6-1-aarch64-ARCH.
_kernel() {
    local dirs=(/usr/lib/modules/*/build)
    basename "$(dirname "${dirs[0]}")"
}

prepare() {
    local kernel
    kernel=$(_kernel)
    # The files come from one release and the headers can be of a newer one.
    # The driver changes little, so the build goes on, but it says so: the
    # right fix is to move pkgver to the new release and its checksums.
    if [[ $kernel != "$pkgver"-* ]]; then
        warning "the headers are for $kernel; the driver is from $pkgver"
    fi
}

build() {
    make -C "/usr/lib/modules/$(_kernel)/build" M="$srcdir" CONFIG_SND_VIRTIO=m modules
}

package() {
    install -Dm644 "$srcdir/virtio_snd.ko" \
        "$pkgdir/usr/lib/modules/$(_kernel)/extramodules/virtio_snd.ko"
}
