#!/usr/bin/expect -f
# End-to-end test: boot live image -> run installer -> power off ->
# boot the installed disk alone -> check it's the installed system.
#
# Drives the VM's serial console. Run via `make test`.

log_user 1

source [file dirname [info script]]/lib.exp
# Every step of this test is slow: the installer writes a disk, and a boot
# follows it. There is no short step here to hurry, so the wait stays long.
set timeout 180

exec rm -f out/vm/target.img

send_user "\n=== Stage 1: install from live image ===\n"
spawn $env(APUS_VM) live
login
# The mark is on the same line as the installer, so the shell prints it when
# the installer ends. A line sent while the installer still runs can be
# eaten by it.
send "apus-install -y /dev/vdb; printf 'INSTALL-%s\\n' done\r"
expect {
    "Installation complete" {}
    "apus-install:"     { fail "installer reported an error" }
    timeout                 { fail "installer timed out" }
}
expect {
    "INSTALL-done" {}
    timeout        { fail "the installer did not give the shell back" }
}
send "poweroff\r"
expect {
    eof     {}
    timeout { fail "live VM didn't power off" }
}
wait

send_user "\n=== Stage 2: boot installed disk ===\n"
# This machine has no display (VM_GPU is unset), so the shell cannot start
# on it and `login` does not ask for it. tests/display.exp boots the same
# disk with a screen, and that is where the shell must be running.
spawn $env(APUS_VM) installed
login
send "cat /etc/apus-installed >/dev/null && grep -qx ID=apus /etc/os-release && pacman -Q apus-release >/dev/null && mountpoint -q /boot && test -f /boot/Image && ! grep -qw apus.live /proc/cmdline && touch /rw-check && pacman -Q linux-aarch64 >/dev/null && echo INSTALLED-\$((1+1))\r"
expect {
    # The command line reads INSTALLED-$((1+1)), so only real output matches.
    "INSTALLED-2" {}
    timeout          { fail "installed system checks failed" }
}
# Informational: any failed units show up in the log. The wait for the
# system to settle can take a while, so the mark goes on the same line.
guest "systemctl is-system-running --wait; systemctl --failed --no-legend" \
    "the units of the system"
send "poweroff\r"
expect eof
wait

send_user "\n\nTEST PASSED\n"
