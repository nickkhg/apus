#!/usr/bin/expect -f
# Display test: boot the installed disk with a (headless) GPU, run the Swift
# UI checks, let mydistro-display-probe draw, and check the pixels it drew.
# Run after tests/install.exp.
#
# The probe writes the picture itself, into the `screens` share (out/vm/screens
# on the Mac): no compositor runs in this test, and Apple's Virtualization
# framework gives the host no way to photograph the screen of a guest.

set timeout 120
log_user 1
source [file dirname [info script]]/lib.exp

# This is the first test of the installed system, so it is the one that holds
# that the machine starts into its shell. `login` then stops the shell, and
# the probe below has the screen to itself.
set expectShell 1
spawn env VM_GPU=headless $env(MYDISTRO_VM) installed
login

# out/ on the Mac is shared at /mnt/host (the `make ui` dev loop uses it).
send "test -f /mnt/host/live.img && echo SHARE-\$((1+1))\r"
expect {
    "SHARE-2" {}
    timeout   { fail "host share /mnt/host not available" }
}
expect -re "# $"

send "mydistro-ui-check\r"
expect {
    "UI-CHECK-OK"     {}
    "UI-CHECK-FAILED" { fail "mydistro-ui-check reported failures" }
    timeout           { fail "mydistro-ui-check timed out" }
}
expect -re "# $"

send "mydistro-display-probe --hold 15 --write /mnt/screens/screen.ppm\r"
expect {
    -re {PROBE-READY [0-9]+x[0-9]+} {}
    "mydistro-display-probe:"       { fail "display probe reported an error" }
    timeout                         { fail "display probe timed out" }
}
after 1000
if {[catch {exec python3 tests/screen.py out/vm/screens/screen.ppm 0.125,0.125=965ADC 0.5,0.5=FFFFFF} result]} {
    fail "screenshot check: $result"
}
send_user "\n$result\n"
expect {
    "PROBE-DONE" {}
    timeout      { fail "display probe didn't finish" }
}
expect -re "# $"
send "poweroff\r"
expect eof
wait

send_user "\n\nDISPLAY TEST PASSED\n"
