#!/usr/bin/expect -f
# Compositor test: boot the installed disk with a (headless) GPU, start
# mydistro-compositor, open a window with mydistro-hello-client, screenshot
# the VM and check the pixels. Run after tests/install.exp.
#
# With MYDISTRO_UI_DIR set (for example /mnt/host/ui, `make test-dev`), the
# VM runs the programs from that directory, not the installed ones.

set timeout 120
log_user 1
source [file dirname [info script]]/lib.exp

set bin ""
if {[info exists env(MYDISTRO_UI_DIR)]} { set bin "$env(MYDISTRO_UI_DIR)/" }

spawn env VM_GPU=headless vm/run.sh installed
login

# Root on the serial console has no seat session: libseat opens devices directly.
send "LIBSEAT_BACKEND=noop ${bin}mydistro-compositor &\r"
expect {
    "COMPOSITOR-READY"     {}
    "mydistro-compositor:" { fail "compositor reported an error" }
    timeout                { fail "compositor didn't start" }
}

send "${bin}mydistro-hello-client --seconds 120 &\r"
expect {
    "WINDOW-MAPPED"          {}
    "mydistro-hello-client:" { fail "client reported an error" }
    timeout                  { fail "window never mapped" }
}
after 1000

# 1280x800 screen. The shell panel is the top 28 pixels. The 400x300 window is
# centred in the space under it, at 440,264. The pointer starts at the centre.
#
#   128,80        the desktop background
#   2,14          the panel background, left of the padding
#   12,4-100,24   the name "mydistro" is drawn on the panel
#   150,4-500,24  the window title is drawn on the panel
#   576,360       inside the window
#   444,268       the window's white border, 4 pixels in
#   444,254       above the window: the background, because the panel moved it
#   640,400       the pointer's outline, and 641,402 its white fill
if {[catch {exec python3 tests/screen.py out/vm/monitor.sock out/vm/screen.ppm \
        128,80=2B2340 2,14=1B1626 12,4-100,24!1B1626 150,4-500,24!1B1626 \
        576,360=3070F0 444,268=FFFFFF 444,254=2B2340 \
        564,730-716,774!2B2340 570,740-571,741!4C8DF6 \
        640,400=000000 641,402=FFFFFF} result]} {
    fail "screenshot check: $result"
}
send_user "\n$result\n"

# The dock icons react to the pointer. The first icon is at 564,730 to
# 608,774. The pointer goes on it, below and right of the checked pixel, so
# that the pointer image does not cover the pixel. The icon then has its full
# colour (4C8DF6), and not the colour that it has at rest.
if {[catch {exec python3 tests/screen.py out/vm/monitor.sock out/vm/hover.ppm \
        --pointer 600,760 570,740=4C8DF6} result]} {
    fail "hover check: $result"
}
send_user "\n$result\n"

# The pointer leaves the icon. The icon gets its colour at rest again, and the
# compositor keeps running: a handler that asks for a new frame must not bring
# the compositor back into the same handler.
if {[catch {exec python3 tests/screen.py out/vm/monitor.sock out/vm/leave.ppm \
        --pointer 300,400 570,740-571,741!4C8DF6 564,730-716,774!2B2340} result]} {
    fail "hover leave check: $result"
}
send_user "\n$result\n"

# A click on the first dock icon does an action: the item gets a dot under it
# and the desktop takes the colour of the item (4C8DF6 darkened: 152745).
if {[catch {exec python3 tests/screen.py out/vm/monitor.sock out/vm/click.ppm \
        --pointer 586,745 --click 128,80=152745 586,771=FFFFFF} result]} {
    fail "dock click check: $result"
}
send_user "\n$result\n"

# The Close button of the panel sends xdg_toplevel.close to the front window.
# mydistro-hello-client stops when it gets that, so the window goes away.
if {[catch {exec python3 tests/screen.py out/vm/monitor.sock out/vm/close.ppm \
        --pointer 1200,14 --click 576,360=152745} result]} {
    fail "close button check: $result"
}
send_user "\n$result\n"

expect {
    "WINDOW-CLOSE-SENT" {}
    timeout             { fail "the compositor sent no close to the window" }
}

send "kill %1\r"
expect {
    "COMPOSITOR-EXIT" {}
    timeout           { fail "compositor didn't exit on SIGTERM" }
}
send "\r"
expect -re "# $"
send "poweroff\r"
expect eof
wait

send_user "\n\nCOMPOSITOR TEST PASSED\n"
