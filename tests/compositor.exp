#!/usr/bin/expect -f
# Compositor test: boot the installed disk with a (headless) GPU, start
# mydistro-compositor, then use Summon to open the apps of /Applications.
# The test moves the pointer, presses keys, types, and checks the pixels of
# the screen. Run after tests/install.exp.
#
# The guest does the seeing and the touching, with mydistro-screen: it asks
# the compositor for the pixels it is showing, and makes a pointer and a
# keyboard with uinput. Apple's Virtualization framework, unlike QEMU, gives
# the host no way to do either. The pictures land in the `screens` share
# (out/vm/screens on the Mac), where tests/screen.py checks them.
#
# With MYDISTRO_UI_DIR set (for example /mnt/host/ui, `make test-dev`), the
# VM runs the programs from that directory, not the installed ones.
#
# The screen is 1280x800. There is no dock and no panel: the rail is the
# only chrome, and Summon starts an app and moves to a window.
#
#   the desktop      07080A
#   the rail         56 wide, 8 from every edge: x 8 to 64, y 8 to 792
#   the Summon key   the button at the top of the rail: x 16 to 56, y 24 to 64
#   the canvas       x 72 to 1272, y 8 to 792: 1200 x 784
#   one window       the whole canvas: a cell of 1200x784 at 72,8
#   two windows      the large cell is the canvas less a band of tiles:
#                    1200 - 256 - 8 = 936, so a cell of 936x784 at 72,8
#   the head         the top 32 of a cell, which the shell keeps. A window
#                    gets the rest, less 8 on the other three sides. So a
#                    cell of 1200x784 at 72,8 gives the window 1184x744
#                    at 80,40.

set timeout 180
log_user 1
source [file dirname [info script]]/lib.exp

set bin ""
set uienv ""
if {[info exists env(MYDISTRO_UI_DIR)]} {
    set bin "$env(MYDISTRO_UI_DIR)/"
    # The compositor starts the apps of /Applications, so it needs the
    # directory in its own environment. Without this the compositor is the
    # new build and every app it starts is the one in the image.
    set uienv "MYDISTRO_UI_DIR=$env(MYDISTRO_UI_DIR) "
}
# How many pixels there are to a point. A screen with small pixels wants 2.
if {[info exists env(MYDISTRO_SCALE)]} {
    append uienv "MYDISTRO_SCALE=$env(MYDISTRO_SCALE) "
}

# Moves the pointer, clicks or types, in the guest.
#
# The compositor and the apps write to the same console as the shell. A wait
# for the shell prompt therefore reads their messages too, and a later
# `expect` never sees them. So when a program is expected to say something
# while the input happens, use `act_start`, then the expects for those
# messages, then `act_done`.
proc act_start {args} {
    # With MYDISTRO_UI_DIR the tool comes from that directory too, so that a
    # test can use an option that the installed tool does not have yet.
    global bin
    set command "${bin}mydistro-screen input"
    foreach argument $args {
        # The text of --type has spaces and shell characters (">"), so each
        # argument goes to the guest shell in single quotes. Without them the
        # shell splits the text and reads ">" as a redirection.
        append command " '[string map {' '\\''} $argument]'"
    }
    send "$command\r"
}

proc act_done {} {
    expect {
        "mydistro-screen:" { fail "the input command failed" }
        -re {# $}          {}
        timeout            { fail "the input command did not finish" }
    }
}

proc act {args} {
    act_start {*}$args
    act_done
}

# Writes the screen in the guest, then checks the pixels on the Mac.
proc screen {name args} {
    global bin
    send "${bin}mydistro-screen shot /mnt/screens/$name.ppm\r"
    expect {
        "mydistro-screen:" { fail "$name: the compositor gave no picture" }
        -re {ok [0-9]+ [0-9]+} {}
        timeout            { fail "$name: no picture" }
    }
    expect -re {# $}
    if {[catch {exec python3 tests/screen.py out/vm/screens/$name.ppm {*}$args} result]} {
        fail "$name check: $result"
    }
    send_user "\n$result\n"
}

spawn env VM_GPU=headless $env(MYDISTRO_VM) installed
login

# Root on the serial console has no seat session: libseat opens devices directly.
send "LIBSEAT_BACKEND=noop MYDISTRO_SCREENSHOT_SOCKET=/run/mydistro-screenshot.sock ${uienv}${bin}mydistro-compositor &\r"
expect {
    "COMPOSITOR-READY"     {}
    "mydistro-compositor:" { fail "compositor reported an error" }
    timeout                { fail "compositor didn't start" }
}
after 1000

# The desktop, the rail on the left edge, and the Summon button at the top
# of it. The pointer is in the middle of the screen.
screen start 128,80=07080A 36,400=12161A 22,44=1D2A12 \
    640,400=000000 641,402=FFFFFF

# The pointer is parked out of the way, so that it covers no pixel that the
# checks below read.
act --pointer 1200,740

# The Super key opens Summon. The surface is 720 wide and in the middle, so
# it covers the middle of the screen, and what is under it is dimmed.
act --key super
# Summon comes in over 160 ms, so the screen is read after it arrives. The
# pixels of a picture are checked, and a picture of a move is not a picture
# of the design.
after 500
# The surface is 720 wide and in the middle of the screen, so x 280 to 1000.
# A point to the left of it shows the desktop with the dim layer over it.
screen summon 640,120=12161A 150,400=020203

# The query narrows the list to one line, and Enter starts that app. The
# compositor gives the window the whole canvas, because it is the only one.
act_start --type "terminal" --key enter
expect {
    "APP-STARTED org.mydistro.terminal" {}
    timeout { fail "Summon did not start the terminal" }
}
expect {
    "TERMINAL-READY"      {}
    "mydistro-terminal:"  { fail "the terminal reported an error" }
    timeout               { fail "the terminal did not open a pseudo terminal" }
}
expect {
    -re {WINDOW-MAPPED "Terminal" 1184x744 at 80,40} {}
    timeout { fail "the terminal window did not fill the canvas" }
}
act_done
after 1000

# The head over the window: the accent line that says it has the keyboard,
# and the bar with the name of the app in it. Then the window of the
# terminal: its background, and the prompt of the shell in the first line.
screen terminal 400,9=A9E34B 400,24=12161A 90,16-300,30!12161A \
    400,400=14111E 88,44-500,70!14111E

# The keyboard reaches the app: the compositor sends the keys to the window
# in front. The shell in the terminal runs what the test types.
act --type "echo typed-ok > /tmp/typed\\n"
screen typing 88,44-700,140!14111E
send "cat /tmp/typed\r"
expect {
    "typed-ok" {}
    timeout    { fail "the shell in the terminal did not get the keys" }
}

# A second app opens. It becomes the principal window and takes the large
# cell. The terminal named no smallest size, so it answers the tile that the
# band proposes, and it moves into a tile of 256 x 256.
act_start --key super --type "hello" --key enter
# The layout runs before the new window is mapped, so the terminal moves
# first.
expect {
    -re {WINDOW-CONFIGURED "[^"]*" 256x256} {}
    timeout { fail "the first window did not move into a tile" }
}
expect {
    -re {WINDOW-MAPPED "Hello from Swift" 920x744 at 80,40} {}
    timeout { fail "the second window did not take the principal cell" }
}
act_done
after 1000
# The terminal in a tile does not draw a small grid. It draws a card that
# states what the shell is doing, on the background of the terminal. The
# tile is 256 wide at x 1016, and 256 tall from y 8.
screen open-hello 400,400=3070F0 84,44=FFFFFF \
    1100,200=14111E 1040,24-1250,44!14111E

# The terminal comes back to the front. Hello named a smallest size of
# 600 x 400, so it cannot use a tile of 256: the band holds a square cell
# for it and the shell draws a stand-in card there, while the window itself
# waits in the rail and draws nothing.
act_start --key super --type "terminal" --key enter
expect {
    -re {WINDOW-IN-RAIL "Hello from Swift"} {}
    timeout { fail "the window that cannot fit a tile did not go to the rail" }
}
act_done
after 1000
# The card is in the first cell of the band: 256 wide at x 1016, 256 tall
# from y 8. Its background is the colour of an empty cell, and its head
# names the app.
screen stand-in 1100,200=0E1114 1040,24-1250,44!0E1114

# Hello comes back to the front, so that it has a cell again and the step
# below closes it and not the terminal.
act_start --key super --type "hello" --key enter
# Hello kept the size it had before it went to the rail, so it is the
# terminal that moves: out of the large cell and back into a tile.
expect {
    -re {WINDOW-CONFIGURED "[^"]*" 256x256 was 920x744} {}
    timeout { fail "the window in the rail did not come back to the large cell" }
}
act_done
after 1000

# A command of Summon gives the canvas to another layout. Side by side
# splits the canvas in two: each half is (1200 - 8) / 2 = 596 wide, and the
# window in it gets 580 x 744 once the shell has taken its head.
act_start --key super --type "side" --key enter
expect {
    -re {LAYOUT sideBySide} {}
    timeout { fail "Summon did not change the layout" }
}
expect {
    -re {WINDOW-CONFIGURED "[^"]*" 580x744} {}
    timeout { fail "the windows did not take half of the canvas each" }
}
act_done
after 1000
# Two windows, side by side: the terminal on one half and hello on the
# other. The head of each one sits over its own half.
screen side-by-side 300,400=3070F0 900,400=14111E

# Back to the principal layout for the steps below.
act_start --key super --type "principal" --key enter
expect {
    -re {LAYOUT principal} {}
    timeout { fail "Summon did not go back to the principal layout" }
}
act_done
after 1000

# A command of Summon closes the window in front. The window of the terminal
# is then in front again, and it gets the keys again.
act_start --key super --type "close" --key enter
expect {
    "WINDOW-CLOSE-SENT" {}
    timeout             { fail "the compositor sent no close to the window" }
}
act_done
after 1000
screen close-hello 400,400=14111E
act --type "echo again-ok > /tmp/again\\n"
screen typing-again 88,44-700,180!14111E
send "cat /tmp/again\r"
expect {
    "again-ok" {}
    timeout    { fail "the keys did not come back to the terminal" }
}

# Closing the last window gives the desktop back. The rail stays, because it
# is there whether a window is open or not.
act_start --key super --type "close" --key enter
expect {
    "WINDOW-CLOSE-SENT" {}
    timeout             { fail "the compositor sent no close to the last window" }
}
act_done
after 1000
# Nothing is open, so the canvas says how to open something. The message is
# in the middle of the canvas, which is 1200 x 784 at 72,8.
screen close-terminal 400,400=07080A 36,400=12161A \
    560,370-790,420!07080A

send "\r"
expect -re "# $"
send "kill %1\r"
expect {
    "COMPOSITOR-EXIT" {}
    timeout           { fail "compositor didn't exit on SIGTERM" }
}
send "\r"
expect -re "# $"
send "poweroff\r"
expect eof
wait

send_user "\n\nCOMPOSITOR TEST PASSED\n"
