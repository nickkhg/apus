#!/usr/bin/expect -f
# Compositor test: boot the installed disk with a (headless) GPU, start
# mydistro-compositor, then use the dock to open the apps of /Applications.
# The test moves the pointer, clicks, types on the keyboard, and checks the
# pixels of the screen. Run after tests/install.exp.
#
# With MYDISTRO_UI_DIR set (for example /mnt/host/ui, `make test-dev`), the
# VM runs the programs from that directory, not the installed ones.
#
# The screen is 1280x800:
#
#   the panel        the top 28 lines
#   the app area     y 28 to 702; a window of an app fills it
#   the dock         73 high, 16 over the bottom: y 711 to 784
#   the icons        44 wide, 10 apart, in the middle: Hello at x 591,
#                    Terminal at x 645, both from y 721 to 765

set timeout 180
log_user 1
source [file dirname [info script]]/lib.exp

set bin ""
set uienv ""
if {[info exists env(MYDISTRO_UI_DIR)]} {
    set bin "$env(MYDISTRO_UI_DIR)/"
    # The compositor starts the apps of /Applications, so it needs the
    # directory in its own environment. Without this the compositor is the
    # new build and every app it starts is the one in the image.
    set uienv "MYDISTRO_UI_DIR=$env(MYDISTRO_UI_DIR) "
}
# How many pixels there are to a point. A screen with small pixels wants 2.
if {[info exists env(MYDISTRO_SCALE)]} {
    append uienv "MYDISTRO_SCALE=$env(MYDISTRO_SCALE) "
}

proc screen {name args} {
    if {[catch {exec python3 tests/screen.py out/vm/monitor.sock out/vm/$name.ppm {*}$args} result]} {
        fail "$name check: $result"
    }
    send_user "\n$result\n"
}

spawn env VM_GPU=headless vm/run.sh installed
login

# Root on the serial console has no seat session: libseat opens devices directly.
send "LIBSEAT_BACKEND=noop ${uienv}${bin}mydistro-compositor &\r"
expect {
    "COMPOSITOR-READY"     {}
    "mydistro-compositor:" { fail "compositor reported an error" }
    timeout                { fail "compositor didn't start" }
}
after 1000

# The desktop, the panel with the name of the system, the dock with an icon
# for each app, and the pointer in the middle of the screen.
screen start 128,80=2B2340 2,14=1B1626 12,4-100,24!1B1626 \
    591,721-635,765!2B2340 645,721-689,765!2B2340 \
    640,400=000000 641,402=FFFFFF

# The icons answer the pointer: the first one takes its full colour (3070F0)
# when the pointer is over it. The pointer goes below and right of the pixel
# that the test reads, so that the pointer image does not cover it.
screen hover --pointer 620,755 600,730=3070F0

# The pointer leaves the icon, and the compositor keeps running: a handler
# that asks for a new frame must not bring the compositor into that handler
# again.
screen leave --pointer 300,400 600,730-601,731!3070F0

# A click on the Terminal icon starts the app. The compositor gives the
# window the app area, and the app draws the shell in it.
screen open-terminal --pointer 667,750 --click
expect {
    "APP-STARTED org.mydistro.terminal" {}
    timeout { fail "the dock did not start the terminal" }
}
expect {
    "TERMINAL-READY"      {}
    "mydistro-terminal:"  { fail "the terminal reported an error" }
    timeout               { fail "the terminal did not open a pseudo terminal" }
}
expect {
    -re {WINDOW-MAPPED "Terminal" 1280x675 at 0,28} {}
    timeout { fail "the terminal window did not fill the app area" }
}
after 1000

# The window of the terminal: its background, the prompt of the shell in the
# first line, and the dot under the icon of the app that is open.
screen terminal 640,400=14111E 0,28-500,52!14111E 667,771=FFFFFF

# The keyboard reaches the app: the compositor sends the keys to the window
# in front. The shell in the terminal runs what the test types.
screen typing --type "echo typed-ok > /tmp/typed\\n" 0,28-700,120!14111E
send "cat /tmp/typed\r"
expect {
    "typed-ok" {}
    timeout    { fail "the shell in the terminal did not get the keys" }
}

# A second app opens. It becomes the principal window and takes the large
# cell, which is the app area less the band of tiles: 1280 - 256 - 8 = 1016.
# The window of the terminal answers 675 for a tile that holds 384 at most,
# so it cannot use one and it waits in the rail.
screen open-hello --pointer 613,750 --click 640,400=3070F0 4,32=FFFFFF
# The layout runs before the window is mapped, so the rail comes first.
expect {
    -re {WINDOW-IN-RAIL "Terminal"} {}
    timeout { fail "the first window did not go to the rail" }
}
expect {
    -re {WINDOW-MAPPED "Hello from Swift" 1016x675 at 0,28} {}
    timeout { fail "the second window did not take the principal cell" }
}

# The Close button of the panel closes the window in front. The window of the
# terminal is then in front again, and it gets the keys again.
screen close-hello --pointer 1200,14 --click 640,400=14111E
expect {
    "WINDOW-CLOSE-SENT" {}
    timeout             { fail "the compositor sent no close to the window" }
}
screen typing-again --type "echo again-ok > /tmp/again\\n" 0,28-700,160!14111E
send "cat /tmp/again\r"
expect {
    "again-ok" {}
    timeout    { fail "the keys did not come back to the terminal" }
}

# Closing the last window gives the desktop back, and the dot under the icon
# goes away: that pixel is the background of the dock again (1B1626 at 0.85
# over the desktop is 171320).
screen close-terminal --pointer 1200,14 --click 640,400=2B2340 667,771=171320

send "\r"
expect -re "# $"
send "kill %1\r"
expect {
    "COMPOSITOR-EXIT" {}
    timeout           { fail "compositor didn't exit on SIGTERM" }
}
send "\r"
expect -re "# $"
send "poweroff\r"
expect eof
wait

send_user "\n\nCOMPOSITOR TEST PASSED\n"
