#!/usr/bin/expect -f
# GPU renderer test: boot the installed disk with a (headless) GPU, draw the
# same screen with each renderer, and check that the two agree.
# Run after tests/install.exp.
#
# The GPU renderer draws the display list through GBM, EGL and GLES, and the
# CPU renderer draws it into a dumb buffer. Both take the same list, so both
# must make the same picture. tests/renderers.py holds that.
#
# In a VM there is no GPU, so Mesa renders with the CPU (llvmpipe). The code
# path is the same, which is what this test covers: EGL on GBM, the shaders,
# the textures, the page flip of a GBM buffer, and giving the buffers back.
#
# The test reads no part of the shell, so a change to the shell needs no
# change here. tests/compositor.exp checks what the shell draws, with the CPU
# renderer, where the pixels are the same on every run.

set timeout 180
log_user 1
source [file dirname [info script]]/lib.exp

set bin ""
set uienv ""
if {[info exists env(APUS_UI_DIR)]} {
    set bin "$env(APUS_UI_DIR)/"
    set uienv "APUS_UI_DIR=$env(APUS_UI_DIR) "
}

# Waits for the guest to finish what it was given.
#
# A wait for the shell prompt is not sufficient. The compositor and the apps
# write to the same console as the shell, so a prompt can go past while an
# expect is reading their lines, and the wait for it after that never ends.
#
# This sends a command of its own with a number that rises, so nothing
# already in the stream can answer for it, and the shell runs it only after
# the command before it has finished. The number is written as $((N)): the
# shell's echo of the command line then reads "MARK-$((3))" and only the
# output reads "MARK-3", so the echo cannot answer either.
set marks 0

proc settle {what} {
    global marks
    incr marks
    send "echo MARK-\$(($marks))\r"
    expect {
        "MARK-$marks" {}
        timeout { fail "$what: the guest did not answer" }
    }
}

# Runs one command in the guest and waits for it to end.
proc guest {command what} {
    global marks
    incr marks
    send "$command; echo MARK-\$(($marks))\r"
    expect {
        "MARK-$marks" {}
        timeout { fail "$what: the guest did not finish" }
    }
}

# Runs the compositor with one renderer, writes the screen, and stops it.
#
# `mode` is how the shell draws depth. It is pinned, because without it the
# shell follows the renderer, and two pictures would differ because the shell
# chose to draw differently, not because the renderer did. `cpu` asks for
# flat colours, and `gpu` asks for the shadow, the gradient and the blur.
#
# With `summon`, Summon is opened before the picture is taken. That is the
# one surface with a blur under it.
proc drawWith {renderer name {mode cpu} {summon 0}} {
    global bin uienv
    send "LIBSEAT_BACKEND=noop APUS_RENDERER=$renderer APUS_SHELL_MODE=$mode APUS_SCREENSHOT_SOCKET=/run/apus-screenshot.sock ${uienv}${bin}apus-compositor &\r"
    if {$renderer eq "gpu"} {
        # The renderer says which GL it got. In a VM that is llvmpipe.
        expect {
            -re {GPU-RENDERER [^\r\n]*} { send_user "\n$expect_out(0,string)\n" }
            "apus-compositor:"      { fail "the compositor reported an error" }
            timeout                     { fail "the GPU renderer did not start" }
        }
    }
    expect {
        "COMPOSITOR-READY"     {}
        "apus-compositor:" { fail "$renderer: the compositor reported an error" }
        timeout                { fail "$renderer: the compositor did not start" }
    }
    after 1500

    if {$summon} {
        send "${bin}apus-screen input --key super\r"
        expect {
            "pressed super"    {}
            "apus-screen:" { fail "$name: the key did not go in" }
            timeout            { fail "$name: Summon did not answer the key" }
        }
        settle "$name: the key"
        after 1000
    }

    send "${bin}apus-screen shot /mnt/screens/$name.ppm\r"
    expect {
        "apus-screen:"     { fail "$renderer: the compositor gave no picture" }
        -re {ok [0-9]+ [0-9]+} {}
        timeout                { fail "$renderer: no picture" }
    }
    settle "$renderer: the picture"

    # Stopping matters: a GBM surface with a buffer still lent to the display
    # never goes away, and the compositor would not stop.
    #
    # `%%` is the job that started last. The second compositor of this test
    # is job 2, so `kill %1` would say "no such job".
    send "kill %%\r"
    expect {
        "COMPOSITOR-EXIT" {}
        timeout           { fail "$renderer: the compositor did not stop" }
    }
    settle "$renderer: the exit"

    # COMPOSITOR-EXIT comes before the process goes: the message is printed,
    # and then the screen, the GL context and the DRM device are given back.
    # The next compositor cannot become DRM master while the last one still
    # holds the device, and drmModeSetCrtc then says "Permission denied".
    # `wait` waits for the job to really end.
    guest "wait" "$renderer: the compositor did not go away"
}

# Two pictures that must be the same picture.
proc same {first second what {options {}}} {
    set command [concat [list python3 tests/renderers.py \
        out/vm/screens/$first.ppm out/vm/screens/$second.ppm] $options]
    if {[catch {exec {*}$command} result]} {
        fail "$what disagree: $result"
    }
    send_user "\n$what agree: $result\n"
}

# Two pictures that must not be the same picture.
proc differs {first second what} {
    if {![catch {exec python3 tests/renderers.py \
            out/vm/screens/$first.ppm out/vm/screens/$second.ppm}]} {
        fail "$what: the two pictures are the same"
    }
    send_user "\n$what: the two pictures differ, as they must\n"
}

spawn env VM_GPU=headless $env(APUS_VM) installed
login

# The first mode: flat colours. The two renderers must agree pixel by pixel.
drawWith cpu renderer-cpu
drawWith gpu renderer-gpu
same renderer-cpu renderer-gpu "the renderers"

# The second mode: a shadow under each surface, a gradient in its face, and
# a blur under Summon. Both renderers draw those items, so the two pictures
# must agree here as well. The shadow is the same mask in both, and only the
# arithmetic of the gradient differs, so the allowance is a little wider.
drawWith cpu depth-cpu gpu
drawWith gpu depth-gpu gpu
same depth-cpu depth-gpu "the renderers in the second mode" {--tolerance 10 --allow 6000}

# A mode is not the other mode with the effects turned off. The two must
# therefore draw different screens.
differs renderer-cpu depth-cpu "the two modes"

# The blur: the one item that reads the picture back. Summon is the surface
# that has one under it. A picture of it proves that the GPU renderer can
# copy the screen, make it soft in two passes, and put it back.
drawWith gpu summon-gpu gpu 1
differs depth-gpu summon-gpu "Summon with a blur under it"

send "poweroff\r"
expect eof
wait

send_user "\n\nGPU TEST PASSED\n"
