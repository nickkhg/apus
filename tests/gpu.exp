#!/usr/bin/expect -f
# GPU renderer test: boot the installed disk with a (headless) GPU, start
# mydistro-compositor with MYDISTRO_RENDERER=gpu, and check what it drew.
# Run after tests/install.exp.
#
# The GPU renderer draws the same display list as the CPU renderer, through
# GBM, EGL and GLES. In a VM there is no GPU, so Mesa renders with the CPU
# (llvmpipe); the code path is the same, which is what this test covers.
#
# The checks are the solid colours only: the background of the desktop, the
# background of the panel, and the dock over it. Those must be exact in both
# renderers. Text and the smooth edges of a shape are not checked here,
# because a GPU rounds them its own way. tests/compositor.exp checks those,
# with the CPU renderer, where the pixels are the same on every run.

set timeout 180
log_user 1
source [file dirname [info script]]/lib.exp

set bin ""
set uienv ""
if {[info exists env(MYDISTRO_UI_DIR)]} {
    set bin "$env(MYDISTRO_UI_DIR)/"
    set uienv "MYDISTRO_UI_DIR=$env(MYDISTRO_UI_DIR) "
}

proc screen {name args} {
    global bin
    send "${bin}mydistro-screen shot /mnt/screens/$name.ppm\r"
    expect {
        "mydistro-screen:" { fail "$name: the compositor gave no picture" }
        -re {ok [0-9]+ [0-9]+} {}
        timeout            { fail "$name: no picture" }
    }
    expect -re {# $}
    if {[catch {exec python3 tests/screen.py out/vm/screens/$name.ppm {*}$args} result]} {
        fail "$name check: $result"
    }
    send_user "\n$result\n"
}

spawn env VM_GPU=headless $env(MYDISTRO_VM) installed
login

send "LIBSEAT_BACKEND=noop MYDISTRO_RENDERER=gpu MYDISTRO_SCREENSHOT_SOCKET=/run/mydistro-screenshot.sock ${uienv}${bin}mydistro-compositor &\r"

# The renderer says which GL it got. In a VM that is llvmpipe.
expect {
    -re {GPU-RENDERER [^\r\n]*} { send_user "\n$expect_out(0,string)\n" }
    "mydistro-compositor:"      { fail "the compositor reported an error" }
    timeout                     { fail "the GPU renderer did not start" }
}
expect {
    "COMPOSITOR-READY"     {}
    "mydistro-compositor:" { fail "the compositor reported an error" }
    timeout                { fail "the compositor did not start" }
}
after 1000

# The desktop and the panel are solid fills, and the dock is a filled path
# over the desktop. All three must reach the screen.
screen gpu-start 128,80=2B2340 2,14=1B1626 \
    591,721-635,765!2B2340 645,721-689,765!2B2340

send "\r"
expect -re "# $"
send "kill %1\r"
expect {
    "COMPOSITOR-EXIT" {}
    timeout           { fail "the compositor did not stop" }
}
send "\r"
expect -re "# $"
send "poweroff\r"
expect eof
wait

send_user "\n\nGPU TEST PASSED\n"
