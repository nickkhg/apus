#!/usr/bin/expect -f
# Venus test: the guest finds the GPU of the Mac.
#
# apus-vm is the virtio-gpu device itself (VM_CUSTOM_GPU=1), with
# virglrenderer and Venus behind it. This test asks the guest what Vulkan
# it has. The answer has to name the GPU of this Mac, through Venus.
#
# It needs the renderer, which `build/make-virglrenderer.sh` builds. Without
# it the device carries no 3D and this test fails at the first step. That is
# why `make test` does not run it: see docs/gpu.md.
#
# Nothing in tests/ besides this one turns the device on, so the rest of the
# tests say whether the machine without it still works.

log_user 1
source [file dirname [info script]]/lib.exp
set timeout $slow

spawn env VM_GPU=headless VM_CUSTOM_GPU=1 $env(APUS_VM) installed
login
set timeout $quick

proc drawWith {command name} {
    send "$command LIBSEAT_BACKEND=noop APUS_SHELL_MODE=cpu "
    send "APUS_SCREENSHOT_SOCKET=/run/apus-screenshot.sock "
    send "apus-compositor &\r"
    set timeout $::slow
    expect {
        "COMPOSITOR-READY"     {}
        "apus-compositor:" { fail "$name: the compositor reported an error" }
        timeout                { fail "$name: the compositor did not start" }
    }
    set timeout $::quick
    settledShot $name $name
    send "kill %%\r"
    expect { "COMPOSITOR-EXIT" {} timeout { fail "$name: the compositor did not stop" } }
    mark "$name: the exit"
    # `wait` returns when the compositor is gone, and the mark after it is
    # the word that says so.
    send "wait\r"
    mark "$name: the compositor going away"
}

drawWith "APUS_RENDERER=cpu" "venus-cpu"

# apus-gpu puts Zink and its Vulkan in front of the compositor. The
# renderer line has to name Venus: with anything else the GPU of the Mac is
# not what drew the frame.
send "APUS_RENDERER=gpu LIBSEAT_BACKEND=noop APUS_SHELL_MODE=cpu "
send "APUS_SCREENSHOT_SOCKET=/run/apus-screenshot.sock "
send "apus-gpu apus-compositor &\r"
set timeout $slow
expect {
    -re {GPU-RENDERER [^\r\n]*Venus[^\r\n]*} {
        send_user "\n$expect_out(0,string)\n"
    }
    -re {GPU-RENDERER [^\r\n]*} {
        fail "the GPU of the Mac did not draw: $expect_out(0,string)"
    }
    "apus-compositor:" { fail "the compositor reported an error" }
    timeout                { fail "the compositor did not say what drew" }
}
expect {
    "COMPOSITOR-READY"     {}
    "apus-compositor:" { fail "the compositor reported an error" }
    timeout                { fail "the compositor did not start" }
}
set timeout $quick
settledShot venus-gpu "the GPU"
send "kill %%\r"
expect { "COMPOSITOR-EXIT" {} timeout { fail "the compositor did not stop" } }
mark "the exit of the GPU"
send "wait\r"
mark "the compositor going away"

if {[catch {exec python3 tests/renderers.py \
        out/vm/screens/venus-cpu.ppm out/vm/screens/venus-gpu.ppm} result]} {
    fail "the GPU of the Mac draws a different picture: $result"
}
send_user "\nthe GPU and the CPU agree: $result\n"

# The shell in its GPU mode, through the GPU of the Mac.
#
# Every step above pins APUS_SHELL_MODE=cpu, because the two modes draw
# different pictures on purpose and a comparison of modes can never be a
# comparison of pixels. The result was that the shadow, the blur and the
# gradient never went through Venus in any test, and `make demo-dev` on a
# second Mac was the first run of that pairing. It stopped in MoltenVK.
#
# This step makes no comparison. It asks only that the frame arrives.
send "APUS_RENDERER=gpu LIBSEAT_BACKEND=noop "
send "APUS_SCREENSHOT_SOCKET=/run/apus-screenshot.sock "
send "apus-gpu apus-compositor &\r"
set timeout $slow
expect {
    "COMPOSITOR-READY"     {}
    "apus-compositor:" { fail "the shell in GPU mode reported an error" }
    eof                    { fail "the machine stopped while the shell drew its GPU mode" }
    timeout                { fail "the shell in GPU mode did not start" }
}
set timeout $quick
settledShot venus-gpu-mode "the shell in GPU mode"
send "kill %%\r"
expect { "COMPOSITOR-EXIT" {} timeout { fail "the shell in GPU mode did not stop" } }
mark "the exit of the GPU mode"
send "wait\r"
mark "the shell in GPU mode going away"
send_user "\nthe shell drew its GPU mode through Venus\n"

send "poweroff\r"
expect eof
wait

send_user "\n\nVENUS TEST PASSED\n"
